{
  "name": "@davidsouther/jiffies",
  "version": "2026.4.1",
  "private": false,
  "displayName": "JEFRi Jiffies",
  "type": "module",
  "exports": {
    "./*.ts": "./src/*.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "LICENSE",
    "package.json",
    "README.md",
    "tsconfig.json"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node ./src/server/main.ts",
    "test": "node --test --test-reporter=tap",
    "ci": "node --test --test-reporter=junit",
    "format": "biome format --write",
    "fix": "biome check --write --unsafe",
    "check:format": "biome format",
    "check:lint": "biome check",
    "all": "npm run check:lint && npm run test",
    "stamp": "node scripts/stamp.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@types/dom-navigation": "^1.0.7",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^22.19.19"
  },
  "dependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "jsdom": "^27.4.0",
    "rollup": "^4.61.1",
    "ts-blank-space": "^0.7.0",
    "typescript": "^5.9.3"
  }
}
